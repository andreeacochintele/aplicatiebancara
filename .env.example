# Copy this file to .env and adjust values as needed.
# docker-compose reads this file directly; the backend also loads it via pydantic-settings.

# --- PostgreSQL (used by docker-compose to configure the postgres service) ---
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking
POSTGRES_DB=banking

# --- Backend ---
# Local (non-Docker) DATABASE_URL. When running via `docker compose up`, the
# backend service overrides this to point at the `postgres` container instead.
DATABASE_URL=postgresql+psycopg://banking:banking@localhost:5432/banking
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-value
FRONTEND_ORIGIN=http://localhost:5173

# --- Azure AI Foundry (GPT-5-mini) ---
# Optional for Phase 1: the app boots and runs correctly without these set.
# AI features (Orchestrator/Personal Finance/Credit/Fraud agents) are not
# implemented yet, but their shared client reads these when they are.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=
