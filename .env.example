# Copy this file to .env and fill in your own values.
# docker-compose reads this file directly; the backend also loads it via pydantic-settings.

# --- Database ---
# Shared source of truth is Supabase Postgres. Get the URI from Supabase Dashboard
# -> Project Settings -> Database -> Connection string -> tab "Session pooler"
# (NOT "Direct connection" — IPv6-only, unreachable from Docker Desktop; NOT
# "Transaction pooler" port 6543 — no prepared-statement support). Keep "+psycopg".
# Username is "postgres.[YOUR-PROJECT-REF]" for the pooler, not just "postgres".
DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres

# If your network blocks the Supabase pooler (common on restrictive corporate
# networks), point DATABASE_URL at the local `postgres` service in
# docker-compose.yml instead: postgresql+psycopg://banking:banking@postgres:5432/banking
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking
POSTGRES_DB=banking

# REST API (PostgREST) credentials — not consumed by the backend app today; kept
# here for tooling/MCP use only. Do not use SUPABASE_KEY to bypass backend auth.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=

# --- Backend ---
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-value
FRONTEND_ORIGIN=http://localhost:5173

# --- Azure AI Foundry (GPT-5-mini) ---
# Optional for Phase 1: the app boots and runs correctly without these set.
# AI features (Orchestrator/Personal Finance/Credit/Fraud agents) are not
# implemented yet, but their shared client reads these when they are.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=
