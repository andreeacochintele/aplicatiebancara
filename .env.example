# --- Database mode ---
DATABASE_BACKEND=supabase_rest

# Local Postgres container values.
# Docker may still create the postgres container with these, but the backend
# ignores DATABASE_URL while DATABASE_BACKEND=supabase_rest.
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking
POSTGRES_DB=banking
DATABASE_URL=postgresql+psycopg://banking:banking@postgres:5432/banking

# --- Supabase REST backend ---
# Shared cloud database used by all devs.
SUPABASE_URL=https://qofftbfxgcexooaatcae.supabase.co
SUPABASE_KEY=your_service_role_key_here

# --- Backend ---
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-value
FRONTEND_ORIGIN=http://localhost:5173


# --- Azure AI Foundry (GPT-5-mini) ---
# ENDPOINT is the bare Foundry resource root, e.g. https://<resource>.services.ai.azure.com
# (no /models, no /openai/v1/ — the client appends /openai/v1/ itself). No api-version
# setting: that route is implicitly versioned.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=